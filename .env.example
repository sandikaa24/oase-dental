# ─── 1. DATABASE (Production VPS Postgres / Docker / Staging) ───
DATABASE_URL="postgresql://oase_user:ganti-dengan-password-db-kuat@postgres:5432/oase_db?schema=public"
# DIRECT_URL: Digunakan oleh Prisma Migrate saat menggunakan connection pooler
DIRECT_URL="postgresql://oase_user:ganti-dengan-password-db-kuat@postgres:5432/oase_db?schema=public"

# Khusus Staging Vercel (Supabase pooled 6543 vs direct 5432):
# DATABASE_URL="postgresql://postgres.[ref]:[pwd]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[pwd]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Database Credential (khusus container docker-compose postgres)
POSTGRES_DB="oase_db"
POSTGRES_USER="oase_user"
POSTGRES_PASSWORD="ganti-dengan-password-db-kuat"

# ─── 2. AUTENTIKASI & KEAMANAN (JWT) ───
# Generate via: openssl rand -base64 48
JWT_ACCESS_SECRET="ganti-dengan-string-acak-rahasia-minimal-32-karakter"
JWT_REFRESH_SECRET="ganti-dengan-string-acak-rahasia-berbeda-minimal-32-karakter"
# COOKIE_SECURE: Set 'false' bila menjalankan mode production sementara di jaringan LAN/HTTP tanpa SSL; set 'true' di HTTPS
COOKIE_SECURE="true"

# ─── 3. DOMAIN & WEB APP ───
APP_URL="https://klinik.example.com"
APP_DOMAIN="klinik.example.com" # Digunakan oleh reverse proxy Caddy untuk sertifikat SSL otomatis

# ─── 4. STORAGE DRIVER ADAPTIF ───
# STORAGE_DRIVER: 'local' (default VPS/Docker) atau 'supabase' (khusus Vercel Staging)
STORAGE_DRIVER="local"

# Storage Lokal (bila STORAGE_DRIVER="local"):
UPLOAD_DIR="/app/uploads/expense-proofs"

# Supabase Storage (wajib diisi jika STORAGE_DRIVER="supabase"):
# SUPABASE_URL="https://[project-ref].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ─── 5. BOOTSTRAP SEED PRODUKSI (apps/web/prisma/seed.prod.ts) ───
# Wajib diisi saat menjalankan: pnpm db:seed:prod
SEED_OWNER_EMAIL="owner@klinik.example.com"
SEED_OWNER_PASSWORD="password-owner-sangat-kuat-min-12-char"
SEED_BRANCH_CODE="PUSAT"
SEED_BRANCH_NAME="OASE Dental Clinic — Pusat"
SEED_BRANCH_ADDRESS="Jl. Kesehatan Utama No. 1"
SEED_BRANCH_PHONE="081234567890"
