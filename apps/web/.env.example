# ─── 1. DATABASE ───
# Untuk Docker/PC Lokal:
DATABASE_URL="postgresql://oase_user:password-kuat@localhost:5432/oase_db?schema=public"
# DIRECT_URL: Wajib untuk Prisma Migrate jika DATABASE_URL menggunakan connection pooler (mis. Supabase PgBouncer)
DIRECT_URL="postgresql://oase_user:password-kuat@localhost:5432/oase_db?schema=public"

# Untuk Vercel Serverless Staging (Supabase):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── 2. AUTENTIKASI & KEAMANAN ───
JWT_ACCESS_SECRET="ganti-dengan-string-acak-rahasia-minimal-32-karakter"
JWT_REFRESH_SECRET="ganti-dengan-string-acak-rahasia-berbeda-minimal-32-karakter"
# COOKIE_SECURE: Set 'false' bila menjalankan di jaringan LAN/HTTP tanpa SSL; set 'true' di Vercel/HTTPS
COOKIE_SECURE="true"

# ─── 3. DOMAIN & RUNTIME ───
NODE_ENV="production"
APP_URL="http://localhost:3000"

# ─── 4. STORAGE DRIVER ADAPTIF ───
# STORAGE_DRIVER: 'local' (default untuk Docker/PC Windows) atau 'supabase' (khusus Vercel Serverless Staging)
STORAGE_DRIVER="local"

# Storage Lokal (bila STORAGE_DRIVER="local"):
UPLOAD_DIR="./uploads/expense-proofs"

# Supabase Storage (wajib diisi bila STORAGE_DRIVER="supabase"):
# SUPABASE_URL="https://[project-ref].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ─── 5. BOOTSTRAP SEED PRODUKSI (apps/web/prisma/seed.prod.ts) ───
SEED_OWNER_EMAIL="owner@klinik.example.com"
SEED_OWNER_PASSWORD="password-owner-sangat-kuat-min-12-char"
SEED_BRANCH_CODE="PUSAT"
SEED_BRANCH_NAME="OASE Dental Clinic — Pusat"
SEED_BRANCH_ADDRESS="Jl. Kesehatan Utama No. 1"
SEED_BRANCH_PHONE="081234567890"

